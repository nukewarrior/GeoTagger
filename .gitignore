**/.DS_Store

# Local-only document inspection output
tmp/

# Project documentation is maintained locally and not versioned
docs/

# Frontend dependencies and build output
node_modules/
dist/*
!dist/.gitkeep
coverage/
*.tsbuildinfo

# Rust and Tauri build output
target/
src-tauri/target/
src-tauri/permissions/autogenerated/

# Runtime data and packaged third-party tools
*.geotagger.json
src-tauri/resources/exiftool/*
!src-tauri/resources/exiftool/.gitkeep
!src-tauri/resources/exiftool/README.md

# Editors and local environment
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.env
.env.*
!.env.example

# Platform signing material
*.p12
*.cer
*.provisionprofile
src-tauri/gen/
